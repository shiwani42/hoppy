# Copy to .env.local and fill in. Never commit .env.local.

# Supabase — local values come from `npx supabase status`; cloud values from the project's API settings.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers — leave blank to run with labeled demo (mock) responses.
OPENAI_API_KEY=
GEMINI_API_KEY=
GLM_API_KEY=

# Optional model overrides (defaults in lib/ai/config.ts; verify ids on the providers' docs).
# OPENAI_VISION_MODEL=
# GEMINI_FLASH_MODEL=
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst   (the 3D twin; OPENAI_PORTRAIT_QUALITY=high, OPENAI_IMAGE_QUALITY=medium for poses and stages)
# OPENAI_ART_MODEL=gpt-image-2.5-flare        (scripts/make-art.mjs: food stickers, expert photos)
# GEMINI_IMAGE_MODEL=   (backup twin model when OpenAI is unavailable)
# GEMINI_REPORT_MODEL=
# GLM_CHAT_MODEL=

# Web push — generate with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret the scheduled job sends to /api/cron/reminders.
CRON_SECRET=
